{
  "name": "behavior-lock",
  "version": "0.2.0",
  "description": "Lock observable software behavior before refactors, migrations, upgrades, or AI-assisted changes.",
  "type": "module",
  "bin": { "behavior-lock": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "npm run build:test && node test/run-tests.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "release:check": "npm run check",
    "example": "npm run build && node examples/basic-cli/demo.mjs",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "engines": { "node": ">=22" },
  "keywords": ["regression-testing", "snapshot-testing", "golden-master", "characterization-testing", "ai-coding", "refactoring", "cli", "developer-tools", "testing"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ririri-rgb/behavior-lock.git" },
  "bugs": { "url": "https://github.com/ririri-rgb/behavior-lock/issues" },
  "homepage": "https://github.com/ririri-rgb/behavior-lock#readme",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
